# Hetzner Storagebox Configuration
# Copy this file to .env and configure with your actual values

# Storagebox credentials (required)
STORAGEBOX_USER="u123456"
STORAGEBOX_HOST="u123456.your-storagebox.de"

# SSH configuration
SSH_KEY_PATH="$HOME/.ssh/id_rsa"
SSH_PORT="23"

# Backup settings
DRY_RUN=false
VERBOSE=true

# Rsync options
RSYNC_BANDWIDTH_LIMIT=""  # Leave empty for no limit, or set like "1000" for 1MB/s
RSYNC_TIMEOUT="300"       # Connection timeout in seconds
RSYNC_RETRIES="3"         # Number of retry attempts
RSYNC_MAX_SIZE="2G"       # Maximum file size to transfer (e.g., "2G", "500M")

# Mirror deletions (default true). The backup tracks the source: files deleted on
# the source are removed from the backup, and already-synced paths that now match
# an exclude are purged. This keeps the backup from growing without bound.
# Set to "false" for append-only behaviour (backup keeps every file it has ever seen).
# WARNING: with delete on, removing a file on the source removes it from the backup on
# the next run. Preview first with DRY_RUN=true. Safe with RSYNC_MAX_SIZE (a transfer
# rule, so oversized files are never deleted).
RSYNC_DELETE="true"
RSYNC_MAX_DELETE=""       # Optional cap on deletions per run as a safety valve (e.g. "10000"); empty = no cap

# Exclude patterns (comma-separated, leave empty for no excludes)
# Default excludes prevent backup loops and system/volatile directories
EXCLUDES="/mount/,/mnt/,/media/,/backups/,/backup/,/var/backups/,/tmp/,/proc/,/sys/,/dev/,/run/,/lost+found/,/swapfile,/swap.img,*.swp"

# Better Stack Heartbeat (optional)
# Get your heartbeat URL from Better Stack dashboard
BETTER_STACK_HEARTBEAT=